# secrets & env — keep examples only
secrets/*
!secrets/*.example
*.env
.env
.env.*

# python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/

# local ETL / Doris artefacts (can be multi-GB)
output/
*.xlsx
*.xls
*.csv
*.csv.gz
*.parquet

# local-only ops notes (paths / cluster facts)
docs/lab-report*.md

# editor / OS
.idea/
.vscode/
.cursor/
*.swp
Thumbs.db
Desktop.ini

# ad-hoc local probes at repo root only (archived copies under scripts/archive are OK)
/_probe*.py
/_check*.py
/_explore*.py
/_run_*.py
/_test_*.py
/_bench*.py
/_lab_*.py
!scripts/archive/**
